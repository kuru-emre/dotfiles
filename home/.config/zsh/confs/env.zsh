export NUGET_PACKAGES="$XDG_CACHE_HOME/nuget"
export DOTNET_CLI_HOME="$XDG_CACHE_HOME/dotnet"
export GRADLE_USER_HOME="$XDG_CACHE_HOME/gradle"

# DevOps & Cloud Tools
export DOCKER_CONFIG="$XDG_CONFIG_HOME/docker"
