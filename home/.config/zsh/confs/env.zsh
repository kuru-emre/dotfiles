export GOMODCACHE="$XDG_CACHE_HOME/go/mod"

export PUB_CACHE="$XDG_CACHE_HOME/pub"
export ANALYZER_STATE_LOCATION_OVERRIDE="$XDG_STATE_HOME/dartServer"

export BUN_INSTALL_CACHE_DIR="$XDG_CACHE_HOME/bun"
