[core]
  editor = nvim
  pager = delta

[init]
  defaultBranch = main

[fetch]
  prune = true
  prunetags = true

[push]
  autoSetupRemote = true

[user]
  name = Emre Kuru
  email = kuru.emre@hotmail.com

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    dark = true

[merge]
    conflictStyle = zdiff3