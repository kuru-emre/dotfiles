[Unit]
Description=Caddy Reverse Proxy Container
After=network-online.target
Wants=network-online.target


[Container]
Image=caddy-custom.build
ContainerName=caddy
AutoUpdate=registry

EnvironmentFile=/srv/apps/caddy/.env

Network=proxy.network
PublishPort=80:80
PublishPort=443:443
PublishPort=443:443/udp

Volume=/srv/apps/caddy/Caddyfile:/etc/caddy/Caddyfile:ro,z
Volume=/srv/apps/caddy/data/data:/data
Volume=/srv/apps/caddy/data/config:/config

PidsLimit=200
NoNewPrivileges=true
AddCapability=NET_BIND_SERVICE
DropCapability=ALL


[Service]
Restart=always


[Install]
WantedBy=default.target
