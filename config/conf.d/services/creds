#!/usr/bin/env bash
set -euo pipefail

CRED_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/credstore.encrypted"

mkdir -p "$CRED_DIR"
chmod 700 "$CRED_DIR"

ensure_cred() {
  local name="$1"
  local prompt="$2"
  local target="$CRED_DIR/${name}.cred"

  if [ -s "$target" ]; then
    echo "✓ Credential '$name' already exists."
    return 0
  fi

  systemd-ask-password -n "$prompt" | \
    systemd-creds --user --name="$name" encrypt - "$target"
  chmod 600 "$target"

  systemd-creds --user --name="$name" decrypt "$target" /dev/null
  echo "✓ Initialized and verified '$name'"
}

ensure_cred "keepassxc-pw" "KeePassXC Database Password:"