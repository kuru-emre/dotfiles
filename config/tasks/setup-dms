#!/usr/bin/env bash
#MISE description="Headless DMS + Niri + dms-greeter setup"
#MISE dir="{{mise_config_dir}}"
#MISE skip_if="dms doctor -j 2>/dev/null | jq -e '[.results[] | select(.status == \"error\")] | length == 0' >/dev/null && dms-greeter status >/dev/null 2>&1"

set -euo pipefail

# 1. Deploy Niri/Kitty DMS fragments & bind dms.service to niri.service without prompts
dms setup headless --compositor niri --terminal kitty --skip-existing
dms-greeter install --yes